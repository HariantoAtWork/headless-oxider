# Host port published by docker-compose
RUST_FETCH_HOST_PORT=9381
# Headful/Xvfb profile port (docker compose --profile headful)
RUST_FETCH_HEADFUL_PORT=9382

# Listen port inside the container
RUST_FETCH_PORT=9381

# Chromium binary inside the image
CHROME_PATH=/usr/bin/chromium

# Stealth on by default (protocol profiles + blocklist + humanise)
STEALTH=1

# 0 = new headless; 1 = headed (use compose profile headful + Xvfb)
HEADFUL=0

# native | linux | windows | macos | rotate
FINGERPRINT_PROFILE=native

# Optional residential / upstream proxy
# PROXY_URL=http://user:pass@proxy.example:8080
